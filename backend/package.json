    "sequelize": "^6.35.2",
    "sequelize-typescript": "^2.1.6",
    "redis": "^4.6.12",
    "bull": "^4.12.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
